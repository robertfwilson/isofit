# ==========================================
# Standard Python .gitignore Configuration
# ==========================================

# --- Byte-compiled / optimized / DLL files ---
# These are generated by the Python interpreter when running your code.
__pycache__/
*.py[cod]
*$py.class

# --- C extensions ---
# Shared libraries generated during C-extension compilation.
*.so

# --- Data Libraries and Model Grids ----
bcgrids/
eep_grids/

# --- Distribution / Packaging ---
# Temporary folders and files created when building and packaging your project.
bin/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- PyInstaller ---
# Artifacts created when freezing Python code into standalone executables.
*.manifest
*.spec

# --- Installer logs ---
# Logs generated by pip during package installation.
pip-log.txt
pip-delete-this-directory.txt

# --- Unit test / Coverage reports ---
# Directories and files generated by testing frameworks (pytest, tox, coverage).
htmlcov/
.tox/
.nosetests
.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/

# --- Translations ---
# Compiled translation files.
*.mo
*.pot

# --- Django stuff ---
# Database and log files specific to Django applications.
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# --- Flask stuff ---
# Instance folder for local configuration.
instance/
.webassets-cache

# --- Scrapy stuff ---
# Scrapy crawler data.
.scrapy

# --- Sphinx documentation ---
# Generated documentation output.
docs/_build/

# --- Jupyter Notebook ---
# Checkpoints saved by Jupyter.
.ipynb_checkpoints

# --- IPython ---
# Configuration and history files.
profile_default/
ipython_config.py

# --- Environments ---
# Local virtual environments (always keep these out of version control).
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# --- IDEs and Editors ---
# Project-specific settings for common editors (VS Code, PyCharm, Spyder).
.vscode/
.idea/
.spyderproject
.spyproject
.ropeproject
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# --- mypy and Type Checking ---
# Cache directories for static type checkers.
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.typeguard_cache/

# --- System Files ---
# Operating system metadata files.
.DS_Store
Thumbs.db
